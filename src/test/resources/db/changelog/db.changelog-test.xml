<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd">

    <changeSet id="GCA-51-create-users" author="Opanasenko-Mykhailo" runOrder="first">
        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(255)"/>
            <column name="password" type="VARCHAR(255)"/>
            <column name="is_active" type="BOOLEAN"/>
            <column name="first_name" type="VARCHAR(255)"/>
            <column name="last_name" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="GCA-51-create-trainees" author="Opanasenko-Mykhailo">
        <createTable tableName="trainees">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT"/>
            <column name="date_of_birth" type="DATE"/>
            <column name="address" type="VARCHAR(255)"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="trainees"
                baseColumnNames="user_id"
                constraintName="fk_trainees_users"
                referencedTableName="users"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="GCA-51-create-training-types" author="Opanasenko-Mykhailo">
        <createTable tableName="training_types">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="training_type_name" type="VARCHAR(255)">
                <constraints unique="true" nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="GCA-51-create-trainers" author="Opanasenko-Mykhailo">
        <createTable tableName="trainers">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT"/>
            <column name="specialization_id" type="BIGINT"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="trainers"
                baseColumnNames="user_id"
                constraintName="fk_trainer_users"
                referencedTableName="users"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                baseTableName="trainers"
                baseColumnNames="specialization_id"
                constraintName="fk_trainer_training_type"
                referencedTableName="training_types"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="GCA-51-create-trainings" author="Opanasenko-Mykhailo">
        <createTable tableName="trainings">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="trainee_id" type="BIGINT"/>
            <column name="trainer_id" type="BIGINT"/>
            <column name="type_id" type="BIGINT"/>
            <column name="training_date" type="DATE"/>
            <column name="training_duration" type="INT"/>
            <column name="training_name" type="VARCHAR(255)"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="trainings"
                baseColumnNames="trainee_id"
                constraintName="fk_training_trainee"
                referencedTableName="trainees"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                baseTableName="trainings"
                baseColumnNames="trainer_id"
                constraintName="fk_training_trainer"
                referencedTableName="trainers"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                baseTableName="trainings"
                baseColumnNames="type_id"
                constraintName="fk_training_type"
                referencedTableName="training_types"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="GCA-51-create-trainee-trainer" author="Opanasenko-Mykhailo">
        <createTable tableName="trainee_trainer">
            <column name="trainee_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="trainer_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
                tableName="trainee_trainer"
                columnNames="trainee_id, trainer_id"
                constraintName="pk_trainee_trainer"/>
        <addForeignKeyConstraint
                baseTableName="trainee_trainer"
                baseColumnNames="trainee_id"
                constraintName="fk_tt_trainee"
                referencedTableName="trainees"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                baseTableName="trainee_trainer"
                baseColumnNames="trainer_id"
                constraintName="fk_tt_trainer"
                referencedTableName="trainers"
                referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>
